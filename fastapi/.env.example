# Copy to fastapi/.env and fill in. fastapi/.env is never committed.
# Variables set in the real environment (e.g. by docker compose) win over this file.
# Commented lines show the default value.

# === LLM provider: any OpenAI-compatible API ==================================================
# Either LOGEN_LLM_BASE_URL + LOGEN_LLM_API_KEY (Groq, OpenRouter, OpenAI, a vLLM / Ollama server) ...
# LOGEN_LLM_BASE_URL=https://api.groq.com/openai/v1
# LOGEN_LLM_API_KEY=
# ... or one of the older keys (the first one set is used: GROQ > OPENROUTER > GITHUB > OPENAI):
GROQ_API_KEY=
# OPENROUTER_API_KEY=
# GITHUB_TOKEN=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY also serves the models that exist only on OpenRouter (Llama 3.3 70B, Kimi K2).

# Generation model (older name: GEN_MODEL). Without it: the provider's default (openai/gpt-oss-120b
# on Groq or a custom URL; Llama 3.3 70B when OPENROUTER_API_KEY is set too)
LOGEN_LLM_MODEL=qwen/qwen3.8-27b
# Evaluation models of the quality filter, comma-separated
# LOGEN_LLM_MODEL_EVAL=qwen/qwen3.8-27b,openai/gpt-oss-120b

# LLM batches sent at the same time within one job (1 = one after another); lower it on rate limits
# LOGEN_LLM_MAX_CONCURRENCY=4
# Attempts per LLM call (a rejected key or unknown model fails at once)
# LOGEN_LLM_MAX_RETRIES=6
# Seconds between LLM calls (older name: INTER_CALL_DELAY)
LOGEN_INTER_CALL_DELAY=0.1
# GPT-OSS on Groq: low | medium | high (older name: REASONING_EFFORT)
# LOGEN_REASONING_EFFORT=

# === Embeddings (independent of the LLM provider) ============================================
# local = all-MiniLM-L6-v2 inside the worker (in the Docker image). Groq has no embeddings API.
# LOGEN_EMBED_PROVIDER=local
# LOGEN_EMBED_MODEL=all-MiniLM-L6-v2
# For LOGEN_EMBED_PROVIDER=openai_compatible (without URL / key, the LLM provider's are used):
# LOGEN_EMBED_BASE_URL=
# LOGEN_EMBED_API_KEY=
# The similarity thresholds below are calibrated for MiniLM; check them with another model.

# === Pipeline ================================================================================
# LOGEN_DEDUP_THRESHOLD=0.82          # units at least this similar count as duplicates
# LOGEN_FAITHFULNESS_THRESHOLD=3.0    # average faithfulness (1-5) below this fails an LO
# LOGEN_HINT_QUALITY_THRESHOLD=2.0
# LOGEN_MAX_ATTEMPTS=2                # regeneration rounds for failing LOs
# LOGEN_EXTRACTION_BATCH_SIZE=3       # sections per LLM call
# LOGEN_GENERATION_BATCH_SIZE=5       # units per LLM call
# LOGEN_MC_BATCH_SIZE=5
# LOGEN_EVAL_BATCH_SIZE=              # empty = per model (gpt-oss-120b: 2, others: 8)
# LOGEN_VERIFY_BATCH_SIZE=10          # prerequisite pairs per LLM call
# LOGEN_ENRICH_BATCH_SIZE=10          # question names and times per LLM call

# === Service (/v1 API, worker) ===============================================================
# Required for docker compose: password of the Redis container. Letters and digits only
# (it is part of a URL). Generate one e.g. with: openssl rand -hex 24
LOGEN_REDIS_PASSWORD=

# API keys Laravel sends in X-API-Key (comma-separated). Empty = no key needed (local only!)
LOGEN_API_KEYS=

# LOGEN_MAX_FILES=10                  # files per job
# LOGEN_MAX_UPLOAD_MB=50              # per file
# LOGEN_MAX_ACTIVE_JOBS=10            # queued + running; more -> 429 too_many_jobs
# LOGEN_JOB_TIMEOUT_S=21600           # a job running longer fails (internal_error, reason timeout)
# LOGEN_DOCS_ENABLED=true             # /docs and /openapi.json

# Webhooks to Laravel (sent by the scheduler container). Empty hosts = webhooks off and
# callback_url refused. Hosts are comma-separated, e.g. eceh-backend. With hosts set, the secret
# is required (Laravel has the same one; generate e.g. with: openssl rand -hex 32).
# LOGEN_WEBHOOK_ALLOWED_HOSTS=
# LOGEN_WEBHOOK_SECRET=
# LOGEN_WEBHOOK_TIMEOUT_S=5           # one delivery attempt; retries after 10 s, 60 s, 300 s

# Cleanup (scheduler container): inputs go right after completed / cancelled
# LOGEN_FAILED_INPUT_TTL_HOURS=24     # inputs of a failed job stay this long (POST /retry works until then)
# LOGEN_RESULT_TTL_DAYS=7             # finished jobs are deleted completely after this
# LOGEN_CLEANUP_INTERVAL_S=600        # how often the cleanup runs

# Deployment next to ECEH (docker-compose.eceh.yml): name of ECEH's Docker network
# LOGEN_ECEH_NETWORK=eceh

# Set by docker-compose.yml, needed only when running without compose:
# LOGEN_BACKEND=mock                  # mock | redis
# LOGEN_REDIS_URL=redis://localhost:6379/0
# LOGEN_DATA_DIR=/data
# LOGEN_MOCK_DURATION_S=30            # how long a mock job takes
